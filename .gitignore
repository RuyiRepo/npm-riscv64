# Local scratch used by tooling and verification runs
.dsh/tmp/

# Rendered composite actions (generated by scripts/render.py)
.rendered/
rendered/

# What the build run hands to the hardware run, and what that run hands back:
# the publish reports, the rendered hardware action, the conditional fallback tarball
# and the hardware reports (.dsh/plan.md D41). All of it is an artifact of a run.
.publish-reports/
.physical-action/
.physical-tarball/
.physical/
physical-reports/

# Python bytecode
__pycache__/
*.py[cod]

# Node
node_modules/

# editor swap files
*.swp
*.swo
.container-home/
